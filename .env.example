# GEMINI_API_KEY: Required in upcoming phases for server-side Brain AI calls.
# Never expose secrets to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-side Brain model routing identifiers (Phase 2+)
VION_BRAIN_PLANNER_MODEL="gemini-3.1-pro-preview"
VION_BRAIN_MULTIMODAL_MODEL="gemini-3-flash-preview"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
